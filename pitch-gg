<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>PITCH.GG — Where Gamers Meet</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow+Condensed:wght@400;600;700&family=Barlow:wght@300;400;500&display=swap" rel="stylesheet"/>
<style>
:root{
  --pitch:#00FF87;
  --pitch2:#00C9FF;
  --red:#FF2D55;
  --gold:#FFD700;
  --dark:#080C10;
  --card:#0D1117;
  --card2:#111820;
  --border:rgba(0,255,135,0.15);
  --text:#E8F0FE;
  --muted:#7A8A9A;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  background:var(--dark);
  color:var(--text);
  font-family:'Barlow',sans-serif;
  overflow-x:hidden;
}

/* ─── SCROLLBAR ─── */
::-webkit-scrollbar{width:4px;}
::-webkit-scrollbar-track{background:var(--dark);}
::-webkit-scrollbar-thumb{background:var(--pitch);border-radius:4px;}

/* ─── NOISE OVERLAY ─── */
body::before{
  content:'';
  position:fixed;inset:0;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
  pointer-events:none;z-index:999;opacity:.4;
}

/* ─── NAV ─── */
nav{
  position:fixed;top:0;left:0;right:0;z-index:100;
  display:flex;align-items:center;justify-content:space-between;
  padding:0 32px;height:64px;
  background:rgba(8,12,16,0.92);
  backdrop-filter:blur(20px);
  border-bottom:1px solid var(--border);
}
.nav-logo{
  font-family:'Bebas Neue',sans-serif;
  font-size:1.8rem;letter-spacing:3px;
  background:linear-gradient(135deg,var(--pitch),var(--pitch2));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
}
.nav-links{display:flex;gap:32px;list-style:none;}
.nav-links a{
  text-decoration:none;color:var(--muted);
  font-family:'Barlow Condensed',sans-serif;
  font-size:.95rem;letter-spacing:1.5px;text-transform:uppercase;
  transition:color .2s;
}
.nav-links a:hover{color:var(--pitch);}
.nav-right{display:flex;gap:12px;align-items:center;}
.btn{
  padding:8px 20px;border-radius:4px;font-family:'Barlow Condensed',sans-serif;
  font-size:.9rem;letter-spacing:1px;text-transform:uppercase;cursor:pointer;
  border:none;transition:all .2s;text-decoration:none;display:inline-block;
}
.btn-outline{background:transparent;border:1px solid var(--pitch);color:var(--pitch);}
.btn-outline:hover{background:var(--pitch);color:var(--dark);}
.btn-solid{background:var(--pitch);color:var(--dark);font-weight:700;}
.btn-solid:hover{background:#00e67a;transform:translateY(-1px);}
.btn-red{background:var(--red);color:#fff;font-weight:700;}
.btn-red:hover{background:#e0253f;}

/* ─── HERO ─── */
.hero{
  min-height:100vh;
  display:flex;flex-direction:column;justify-content:center;align-items:center;
  text-align:center;padding:80px 24px 40px;
  position:relative;overflow:hidden;
}
.hero-bg{
  position:absolute;inset:0;
  background:
    radial-gradient(ellipse 80% 50% at 50% 0%,rgba(0,255,135,0.07) 0%,transparent 70%),
    radial-gradient(ellipse 60% 40% at 80% 80%,rgba(0,201,255,0.06) 0%,transparent 70%),
    radial-gradient(ellipse 40% 30% at 20% 60%,rgba(255,45,85,0.04) 0%,transparent 70%);
}
/* Pitch lines */
.hero-bg::before{
  content:'';position:absolute;inset:0;
  background-image:
    linear-gradient(rgba(0,255,135,0.03) 1px,transparent 1px),
    linear-gradient(90deg,rgba(0,255,135,0.03) 1px,transparent 1px);
  background-size:60px 60px;
}
.live-badge{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(255,45,85,0.15);border:1px solid rgba(255,45,85,0.4);
  padding:6px 16px;border-radius:50px;margin-bottom:24px;
  font-family:'Barlow Condensed',sans-serif;font-size:.85rem;letter-spacing:2px;
  text-transform:uppercase;color:var(--red);
  animation:pulse-badge 2s infinite;
}
@keyframes pulse-badge{
  0%,100%{box-shadow:0 0 0 0 rgba(255,45,85,0.3);}
  50%{box-shadow:0 0 0 8px rgba(255,45,85,0);}
}
.live-dot{width:8px;height:8px;border-radius:50%;background:var(--red);animation:blink 1s infinite;}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:.3;}}
.hero h1{
  font-family:'Bebas Neue',sans-serif;
  font-size:clamp(4rem,12vw,9rem);
  line-height:.95;letter-spacing:4px;
  margin-bottom:8px;
}
.hero h1 span{
  display:block;
  background:linear-gradient(135deg,var(--pitch) 0%,var(--pitch2) 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
}
.hero-sub{
  font-size:1.1rem;color:var(--muted);max-width:540px;
  line-height:1.6;margin:16px auto 32px;font-weight:300;
}
.hero-ctas{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-bottom:56px;}
.hero-stats{
  display:flex;gap:48px;flex-wrap:wrap;justify-content:center;
  padding-top:40px;border-top:1px solid var(--border);width:100%;max-width:700px;
}
.stat{text-align:center;}
.stat-n{
  font-family:'Bebas Neue',sans-serif;font-size:2.4rem;letter-spacing:2px;
  background:linear-gradient(135deg,var(--pitch),var(--pitch2));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
}
.stat-l{font-size:.8rem;text-transform:uppercase;letter-spacing:2px;color:var(--muted);}

/* ─── SECTIONS ─── */
section{padding:80px 24px;}
.container{max-width:1200px;margin:0 auto;}
.section-tag{
  display:inline-block;
  font-family:'Barlow Condensed',sans-serif;
  font-size:.8rem;letter-spacing:3px;text-transform:uppercase;
  color:var(--pitch);margin-bottom:12px;
}
.section-title{
  font-family:'Bebas Neue',sans-serif;
  font-size:clamp(2.4rem,5vw,4rem);letter-spacing:3px;
  line-height:1;margin-bottom:8px;
}
.section-sub{color:var(--muted);font-size:1rem;font-weight:300;max-width:500px;}

/* ─── FEATURED GAMERS ─── */
.gamers-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
  gap:16px;margin-top:40px;
}
.gamer-card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:8px;overflow:hidden;
  transition:transform .25s,border-color .25s;
  cursor:pointer;
  animation:fadeUp .5s ease both;
}
.gamer-card:hover{transform:translateY(-6px);border-color:var(--pitch);}
.gamer-card-banner{
  height:80px;
  background:linear-gradient(135deg,#0f2a1f,#0a1a2e);
  position:relative;overflow:hidden;
}
.gamer-card-banner::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,rgba(0,255,135,.15),rgba(0,201,255,.1));
}
.gamer-rank-badge{
  position:absolute;top:8px;right:8px;
  background:var(--gold);color:#000;
  font-family:'Barlow Condensed',sans-serif;
  font-size:.7rem;font-weight:700;letter-spacing:1px;
  padding:2px 8px;border-radius:3px;z-index:2;
}
.gamer-avatar-wrap{
  display:flex;justify-content:center;margin-top:-30px;position:relative;z-index:2;
}
.gamer-avatar{
  width:60px;height:60px;border-radius:50%;
  border:3px solid var(--dark);
  background:linear-gradient(135deg,var(--pitch),var(--pitch2));
  display:flex;align-items:center;justify-content:center;
  font-size:1.5rem;font-weight:700;
  font-family:'Bebas Neue',sans-serif;letter-spacing:1px;color:var(--dark);
}
.gamer-info{padding:12px 16px 16px;text-align:center;}
.gamer-name{font-family:'Barlow Condensed',sans-serif;font-size:1.1rem;font-weight:700;letter-spacing:1px;}
.gamer-country{font-size:.8rem;color:var(--muted);margin:2px 0 8px;}
.gamer-stats-row{
  display:flex;justify-content:space-between;
  border-top:1px solid rgba(255,255,255,0.05);
  padding-top:10px;margin-top:6px;
}
.g-stat{text-align:center;flex:1;}
.g-stat-n{font-family:'Barlow Condensed',sans-serif;font-size:1rem;font-weight:700;color:var(--pitch);}
.g-stat-l{font-size:.65rem;text-transform:uppercase;letter-spacing:1px;color:var(--muted);}
.online-dot{
  display:inline-block;width:7px;height:7px;border-radius:50%;
  background:var(--pitch);margin-right:4px;animation:blink 1.5s infinite;
}

/* ─── GAME CARDS ─── */
.games-row{
  display:flex;gap:16px;overflow-x:auto;padding-bottom:16px;margin-top:40px;
  scroll-snap-type:x mandatory;
}
.games-row::-webkit-scrollbar{height:3px;}
.games-row::-webkit-scrollbar-thumb{background:var(--pitch);}
.game-card{
  flex:0 0 180px;scroll-snap-align:start;
  background:var(--card);border:1px solid var(--border);
  border-radius:8px;padding:20px 16px;text-align:center;
  transition:all .25s;cursor:pointer;
}
.game-card:hover{border-color:var(--pitch2);transform:scale(1.03);}
.game-icon{font-size:2.5rem;margin-bottom:12px;}
.game-title{font-family:'Barlow Condensed',sans-serif;font-size:.95rem;font-weight:700;letter-spacing:1px;margin-bottom:4px;}
.game-players{font-size:.75rem;color:var(--muted);}
.game-active{
  display:inline-block;margin-top:8px;
  font-size:.7rem;color:var(--pitch);
  font-family:'Barlow Condensed',sans-serif;letter-spacing:1px;text-transform:uppercase;
}

/* ─── LEAGUE MAKER ─── */
.league-box{
  background:var(--card);border:1px solid var(--border);
  border-radius:12px;padding:40px;margin-top:40px;
  display:grid;grid-template-columns:1fr 1fr;gap:40px;
  align-items:center;
}
.league-features{display:flex;flex-direction:column;gap:16px;margin-top:24px;}
.feat{
  display:flex;align-items:center;gap:14px;
  background:var(--card2);border:1px solid rgba(0,255,135,0.08);
  border-radius:8px;padding:14px 18px;transition:border-color .2s;
}
.feat:hover{border-color:var(--pitch);}
.feat-icon{font-size:1.4rem;flex-shrink:0;}
.feat-text h4{font-family:'Barlow Condensed',sans-serif;font-size:1rem;font-weight:700;letter-spacing:.5px;}
.feat-text p{font-size:.82rem;color:var(--muted);margin-top:2px;}
.league-preview{
  background:var(--card2);border:1px solid var(--border);
  border-radius:8px;padding:20px;
}
.league-preview-title{
  font-family:'Barlow Condensed',sans-serif;
  font-size:.8rem;letter-spacing:2px;text-transform:uppercase;
  color:var(--muted);margin-bottom:16px;
}
.league-table{width:100%;border-collapse:collapse;font-size:.85rem;}
.league-table th{
  text-align:left;padding:8px 12px;
  font-family:'Barlow Condensed',sans-serif;
  font-size:.75rem;letter-spacing:1.5px;text-transform:uppercase;
  color:var(--muted);border-bottom:1px solid var(--border);
}
.league-table td{padding:10px 12px;border-bottom:1px solid rgba(255,255,255,0.03);}
.league-table tr:hover td{background:rgba(0,255,135,0.03);}
.pos{font-weight:700;color:var(--pitch);font-family:'Barlow Condensed',sans-serif;}
.pts{font-weight:700;color:var(--gold);font-family:'Barlow Condensed',sans-serif;}

/* ─── FRIENDLY REQUEST ─── */
.friendly-section{background:var(--card2);}
.friendly-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:40px;}
.match-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:10px;padding:24px;
  display:flex;flex-direction:column;gap:16px;
}
.match-teams{display:flex;align-items:center;justify-content:space-between;}
.team{text-align:center;flex:1;}
.team-flag{font-size:2rem;margin-bottom:4px;}
.team-name{font-family:'Barlow Condensed',sans-serif;font-size:.95rem;font-weight:700;letter-spacing:.5px;}
.team-gamer{font-size:.75rem;color:var(--muted);}
.vs{
  font-family:'Bebas Neue',sans-serif;font-size:2rem;
  color:var(--muted);letter-spacing:2px;
}
.match-meta{
  display:flex;justify-content:space-between;align-items:center;
  border-top:1px solid rgba(255,255,255,0.05);padding-top:14px;
}
.match-game{font-size:.8rem;color:var(--pitch);font-family:'Barlow Condensed',sans-serif;letter-spacing:1px;}
.match-status-open{
  font-size:.75rem;background:rgba(0,255,135,.12);
  color:var(--pitch);padding:3px 10px;border-radius:4px;
  font-family:'Barlow Condensed',sans-serif;letter-spacing:1px;text-transform:uppercase;
}
.match-status-live{
  font-size:.75rem;background:rgba(255,45,85,.15);
  color:var(--red);padding:3px 10px;border-radius:4px;
  font-family:'Barlow Condensed',sans-serif;letter-spacing:1px;text-transform:uppercase;
  animation:pulse-badge 1.5s infinite;
}

/* ─── TACTICS ─── */
.pitch-container{
  margin-top:40px;display:grid;
  grid-template-columns:1fr 1.5fr 1fr;gap:24px;align-items:start;
}
.tactic-select{display:flex;flex-direction:column;gap:10px;}
.tactic-btn{
  background:var(--card);border:1px solid var(--border);
  border-radius:6px;padding:12px 16px;cursor:pointer;
  font-family:'Barlow Condensed',sans-serif;
  font-size:.95rem;letter-spacing:1px;color:var(--text);
  transition:all .2s;text-align:left;
}
.tactic-btn:hover,.tactic-btn.active{border-color:var(--pitch);color:var(--pitch);background:rgba(0,255,135,.05);}
.pitch-visual{
  background:var(--card);border:1px solid var(--border);
  border-radius:10px;padding:24px;text-align:center;
}
.pitch-svg-wrap{position:relative;width:100%;padding-top:140%;background:#1a2e1a;border-radius:6px;overflow:hidden;}
.pitch-svg-wrap svg{position:absolute;inset:0;width:100%;height:100%;}
.player-pos{
  position:absolute;
  width:32px;height:32px;border-radius:50%;
  background:var(--pitch);color:var(--dark);
  display:flex;align-items:center;justify-content:center;
  font-family:'Barlow Condensed',sans-serif;font-size:.7rem;font-weight:700;
  transform:translate(-50%,-50%);
  box-shadow:0 0 12px rgba(0,255,135,.5);
  cursor:pointer;transition:transform .2s;
}
.player-pos:hover{transform:translate(-50%,-50%) scale(1.15);}
.player-pos.red{background:var(--red);box-shadow:0 0 12px rgba(255,45,85,.5);}
.tactic-info{display:flex;flex-direction:column;gap:12px;}
.tactic-stat-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:8px;padding:14px 16px;
}
.tactic-stat-label{
  font-size:.75rem;text-transform:uppercase;
  letter-spacing:1.5px;color:var(--muted);margin-bottom:6px;
  font-family:'Barlow Condensed',sans-serif;
}
.progress-bar{height:6px;background:rgba(255,255,255,0.06);border-radius:3px;overflow:hidden;}
.progress-fill{height:100%;border-radius:3px;background:linear-gradient(90deg,var(--pitch),var(--pitch2));transition:width .8s ease;}

/* ─── LIVE STREAM SECTION ─── */
.live-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px;margin-top:40px;}
.stream-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:10px;overflow:hidden;transition:transform .2s,border-color .2s;cursor:pointer;
}
.stream-card:hover{transform:translateY(-4px);border-color:var(--red);}
.stream-thumb{
  height:160px;background:linear-gradient(135deg,#0f1f12,#0a1224);
  position:relative;display:flex;align-items:center;justify-content:center;
  font-size:3rem;overflow:hidden;
}
.stream-thumb::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(to bottom,transparent 50%,rgba(8,12,16,.8));
}
.live-pill{
  position:absolute;top:10px;left:10px;z-index:2;
  background:var(--red);color:#fff;
  font-family:'Barlow Condensed',sans-serif;
  font-size:.7rem;letter-spacing:2px;font-weight:700;
  padding:3px 10px;border-radius:3px;
  display:flex;align-items:center;gap:5px;
}
.viewers{
  position:absolute;bottom:10px;right:10px;z-index:2;
  background:rgba(0,0,0,.7);color:var(--text);
  font-size:.75rem;padding:3px 8px;border-radius:4px;
}
.stream-info{padding:14px 16px;}
.stream-title{font-family:'Barlow Condensed',sans-serif;font-size:1rem;font-weight:700;letter-spacing:.5px;margin-bottom:4px;}
.stream-meta{font-size:.8rem;color:var(--muted);}

/* ─── PROFILE MODAL OVERLAY ─── */
.modal-overlay{
  position:fixed;inset:0;background:rgba(0,0,0,.85);
  z-index:200;display:flex;align-items:center;justify-content:center;
  opacity:0;pointer-events:none;transition:opacity .3s;
  backdrop-filter:blur(8px);
}
.modal-overlay.open{opacity:1;pointer-events:all;}
.profile-modal{
  background:var(--card);border:1px solid var(--border);
  border-radius:16px;width:90%;max-width:600px;max-height:85vh;overflow-y:auto;
  animation:slideUp .3s ease;
}
@keyframes slideUp{from{transform:translateY(30px);opacity:0;}to{transform:translateY(0);opacity:1;}}
.modal-banner{
  height:140px;
  background:linear-gradient(135deg,#0f3020,#0a1f3a,#1a0a2e);
  position:relative;
}
.modal-close{
  position:absolute;top:12px;right:12px;
  width:32px;height:32px;border-radius:50%;
  background:rgba(0,0,0,.5);border:none;color:#fff;
  font-size:1.1rem;cursor:pointer;display:flex;align-items:center;justify-content:center;
  transition:background .2s;
}
.modal-close:hover{background:var(--red);}
.modal-avatar-area{
  display:flex;align-items:flex-end;gap:16px;
  padding:0 24px;margin-top:-40px;margin-bottom:16px;
}
.modal-avatar{
  width:80px;height:80px;border-radius:50%;
  border:4px solid var(--dark);
  background:linear-gradient(135deg,var(--pitch),var(--pitch2));
  display:flex;align-items:center;justify-content:center;
  font-family:'Bebas Neue',sans-serif;font-size:2rem;color:var(--dark);flex-shrink:0;
}
.modal-name{font-family:'Bebas Neue',sans-serif;font-size:1.8rem;letter-spacing:2px;line-height:1;}
.modal-handle{font-size:.85rem;color:var(--muted);}
.modal-body{padding:0 24px 24px;}
.modal-tabs{
  display:flex;gap:0;border-bottom:1px solid var(--border);margin-bottom:20px;
}
.modal-tab{
  padding:10px 20px;
  font-family:'Barlow Condensed',sans-serif;
  font-size:.85rem;letter-spacing:1.5px;text-transform:uppercase;
  color:var(--muted);cursor:pointer;border-bottom:2px solid transparent;
  transition:all .2s;
}
.modal-tab.active{color:var(--pitch);border-bottom-color:var(--pitch);}
.modal-stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
.modal-stat{
  background:var(--card2);border:1px solid var(--border);
  border-radius:8px;padding:14px;text-align:center;
}
.modal-stat-n{
  font-family:'Bebas Neue',sans-serif;font-size:1.6rem;
  background:linear-gradient(135deg,var(--pitch),var(--pitch2));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
}
.modal-stat-l{font-size:.7rem;text-transform:uppercase;letter-spacing:1px;color:var(--muted);}
.squad-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:16px;}
.player-card{
  background:var(--card2);border:1px solid rgba(0,255,135,0.08);
  border-radius:6px;padding:10px 8px;text-align:center;font-size:.78rem;
  transition:border-color .2s;cursor:pointer;
}
.player-card:hover{border-color:var(--pitch);}
.player-ovr{
  font-family:'Bebas Neue',sans-serif;font-size:1.3rem;
  color:var(--gold);display:block;
}
.player-pos-badge{
  font-family:'Barlow Condensed',sans-serif;
  font-size:.7rem;color:var(--pitch);letter-spacing:1px;
  display:block;margin-bottom:2px;
}

/* ─── IDEAS FEED ─── */
.feed-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:40px;}
.idea-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:10px;padding:20px;transition:border-color .2s;
}
.idea-card:hover{border-color:var(--pitch2);}
.idea-header{display:flex;gap:12px;align-items:center;margin-bottom:12px;}
.idea-avatar{
  width:38px;height:38px;border-radius:50%;
  background:linear-gradient(135deg,var(--pitch2),#7B2FBE);
  display:flex;align-items:center;justify-content:center;
  font-weight:700;font-size:.9rem;color:#fff;flex-shrink:0;
}
.idea-user{font-family:'Barlow Condensed',sans-serif;font-size:.95rem;font-weight:700;}
.idea-tag{
  margin-left:auto;font-size:.7rem;
  background:rgba(0,201,255,.12);color:var(--pitch2);
  padding:2px 10px;border-radius:4px;
